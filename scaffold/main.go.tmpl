// ws-[[.Name]] is a ws plugin: an app in the web UI, commands after
// `ws [[.Name]]`, and a guide that tells agents they're there.
//
// `ws plugin-dev watch` builds and runs it in a workspace, again on each
// save.
package main

import (
	"context"
	"embed"
	"encoding/json"
	"net/http"

	"github.com/withworkspace/plugin"
)

// What's built into the executable: the guide for agents, the database's
// migrations, and the app as built (ui/dist, from ui/). The built app is
// committed, so Go alone builds the plugin.
//
//go:embed agents.md migrations ui/dist
var files embed.FS

func main() {
	p := plugin.New(files)
	setup(p)
	p.Run()
}

// setup declares the plugin: what it declares is what ws is told it adds.
// It's apart from main so a test can declare the same plugin.
func setup(p *plugin.Plugin) {
	p.Describe("[[.Title]]")

	// Config: declared and read in one. `ws plugin config [[.Name]]` sets it.
	greeting := p.Config.String("greeting", "Greeting", plugin.Default("Hello"))

	// The plugin's own database: migrations/*.sql are applied before
	// anything here runs.
	visits := func(ctx context.Context) (n int, err error) {
		err = p.DB().QueryRowContext(ctx, `select count(*) from visits`).Scan(&n)
		return n, err
	}
	visit := func(ctx context.Context) error {
		_, err := p.DB().ExecContext(ctx, `insert into visits values (unixepoch())`)
		return err
	}

	// The app, and its entry in ws's sidebar. ws serves the page and loads
	// the app in it (ui/src/app.ts): the plugin has no HTML.
	p.UI("ui/dist")
	p.View("[[.Title]]", plugin.Icon("sparkle"))

	// What the app asks, as JSON: the greeting, and how often the app has
	// been seen. The app fetches it at ws.api("/api/visits").
	seen := func(w http.ResponseWriter, r *http.Request) {
		n, err := visits(r.Context())
		if err != nil {
			http.Error(w, err.Error(), http.StatusInternalServerError)
			return
		}
		w.Header().Set("Content-Type", "application/json")
		json.NewEncoder(w).Encode(map[string]any{"greeting": greeting.Get(), "visits": n}) //nolint:errcheck // the app has gone
	}
	p.HandleFunc("GET /api/visits", seen)

	// Each look at the app is counted: it posts here as it loads.
	p.HandleFunc("POST /api/visits", func(w http.ResponseWriter, r *http.Request) {
		if err := visit(r.Context()); err != nil {
			http.Error(w, err.Error(), http.StatusInternalServerError)
			return
		}
		seen(w, r)
	})

	// ws [[.Name]] say [NAME]
	p.Command("say", "Says the greeting", func(c *plugin.Call) error {
		name := "workspace"
		if c.Arg(0) != "" {
			name = c.Arg(0)
		}
		return c.Say(greeting.Get() + ", " + name)
	}).Args("[NAME]")

	// ws [[.Name]] visits: a line for a person, JSON for -f json, markdown
	// for an agent (-f llm), from the one value. With --add it counts one
	// more first, and tells the open app that what it shows is stale
	// (p.Changed): the app asks again, and its count goes up.
	p.Command("visits", "How often the app has been seen", func(c *plugin.Call) error {
		if c.Flag("add") {
			if err := visit(c.Context()); err != nil {
				return err
			}
			p.Changed()
		}
		n, err := visits(c.Context())
		if err != nil {
			return err
		}
		return c.Show(struct {
			Visits int `json:"visits"`
		}{n})
	}).Flag("add", "count one more, and tell the open app")
}
