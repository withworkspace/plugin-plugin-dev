name: Release

# A v* tag builds the plugin for each platform below and publishes the
# builds as a GitHub release: what `ws plugin add owner/repo` installs. The
# release is of the version the tag says: v0.4.0 is 0.4.0. A pull request
# that changes this file runs the builds without releasing, to try them.
on:
  push:
    tags: ["v*"]
  pull_request:
    paths: [".github/workflows/release.yml"]

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6

      - uses: actions/setup-go@v6
        with:
          go-version-file: go.mod

      - name: Build each platform's
        run: |
          name=$(sed -n 's/^name *= *"\(.*\)"/\1/p' plugin.toml)
          case "$GITHUB_REF" in
            refs/tags/*) tag="$GITHUB_REF_NAME" ;;
            *) tag="dev-$(echo "$GITHUB_SHA" | cut -c1-7)" ;;
          esac
          # The version is the tag's. plugin.toml has none in the repo: each
          # build's is given it, under its name.
          version=${tag#v}
          mkdir dist
          # The framework is pure Go, so every platform's is built from here.
          # Each is its plugin.toml and what its command starts (ws-<name>).
          for platform in darwin/arm64 darwin/amd64 linux/amd64 linux/arm64; do
            os=${platform%/*}
            arch=${platform#*/}
            rm -rf out && mkdir out
            CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" go build -trimpath -ldflags="-s -w" -o "out/ws-$name" .
            awk -v v="$version" '/^version *=/ { next } { print } /^name *=/ { print "version = \"" v "\"" }' plugin.toml > out/plugin.toml
            grep -q '^version = ' out/plugin.toml || { echo "plugin.toml has no name line to put the version under"; exit 1; }
            tar -czf "dist/${name}_${tag}_${os}_${arch}.tar.gz" -C out .
          done
          cd dist
          sha256sum *.tar.gz > checksums.txt
          cat checksums.txt

      - uses: actions/upload-artifact@v7
        with:
          name: builds
          path: dist/*
          if-no-files-found: error

  release:
    if: startsWith(github.ref, 'refs/tags/')
    needs: build
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/download-artifact@v8
        with:
          name: builds
          path: dist

      - name: Publish the release
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
        run: |
          cd dist
          prerelease=""
          case "$GITHUB_REF_NAME" in
            *-*) prerelease="--prerelease" ;;
          esac
          gh release create "$GITHUB_REF_NAME" --verify-tag --generate-notes $prerelease *.tar.gz checksums.txt
