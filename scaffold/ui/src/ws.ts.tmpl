// The app's hooks onto ws: where it is, its title, and asking the plugin.
// ws keeps the history: a link to ws.href(…), or ws.go(…), asks it to move,
// and usePath follows when it has. The app never moves first.

import type { Client, Endpoints } from "@withworkspace/ui-lib";
import { useEffect, useRef, useState } from "preact/hooks";
import type { Api } from "./api.gen";

/**
 * Plugin asks the plugin's endpoints (plugin.Get, plugin.Post… in
 * main.go), by what each takes and answers: plugin.get("/api/visits") is a
 * Visits. Api is written from the plugin's Go by `go tool apigen`, so a
 * path that isn't the plugin's, or an answer read as what it isn't,
 * doesn't compile. It's made once, in app.tsx: endpoints<Api>(ws).
 */
export type Plugin = Endpoints<Api>;

/** usePath is the path in the plugin ws's address is at: /p/notes. */
export function usePath(ws: Client): string {
  const [path, setPath] = useState(ws.path);
  useEffect(() => ws.onNavigate(setPath), [ws]);
  return path;
}

/** useTitle says the page's title, for the tab. */
export function useTitle(ws: Client, title: string) {
  useEffect(() => ws.setTitle(title), [ws, title]);
}

/** said is why something failed, as words: what the plugin answered, for an endpoint that couldn't. */
export const said = (err: unknown) => (err instanceof Error ? err.message : String(err));

export interface Asked<T> {
  /** What the plugin last answered, once it has. */
  data?: T;
  /** Why the last ask failed: "" when it didn't. */
  failed: string;
  /** set puts an answer in place of what was asked: a POST's, say. */
  set(data: T): void;
}

/**
 * useAsk asks the plugin, and again each time it says what the app shows
 * is stale (p.Changed() in the Go framework). ask is the asking, and what
 * it's asked with goes beside it, as an effect's does: it asks again when
 * any of that changes.
 *
 *   const issue = useAsk(ws, () => plugin.get("/api/issues/{key}", { params: { key } }), [key]);
 *
 * What it gives is the type the endpoint answers with.
 */
export function useAsk<T>(ws: Client, ask: () => Promise<T>, asked: readonly unknown[] = []): Asked<T> {
  const [state, setState] = useState<{ data?: T; failed: string }>({ failed: "" });
  // The asking as it's last written, which what it's asked with stands for.
  const latest = useRef(ask);
  latest.current = ask;
  useEffect(() => {
    let live = true;
    const load = () =>
      latest.current().then(
        (data) => live && setState({ data, failed: "" }),
        (err) => live && setState((s) => ({ ...s, failed: said(err) })),
      );
    void load();
    const stop = ws.onChanged(() => void load());
    return () => {
      live = false;
      stop();
    };
  }, [ws, ...asked]);
  return { ...state, set: (data) => setState({ data, failed: "" }) };
}
